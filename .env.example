# Copiar a .env . Ninguna clave es obligatoria: lymi corre con los proveedores
# que tengas configurados y omite los demas.

# --- Proveedores remotos (opcionales) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Tier local (opcional, recomendado) ---
# Servidor Ollama. En 4 GB de VRAM cabe entero un modelo 3B cuantizado.
# Evita modelos que razonan (qwen3): gastan cientos de tokens antes de responder.
LYMI_OLLAMA_URL=http://localhost:11434
LYMI_LOCAL_MODEL=qwen2.5:3b
# LYMI_LOCAL_THINK=1   # activa el razonamiento en modelos que lo soportan

# --- Ledger ---
LYMI_DB=runs/lymi.sqlite3
